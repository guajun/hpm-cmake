{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "HPM_SDK_BASE": "${sourceDir}/.hpm/sdk",
        "GNURISCV_TOOLCHAIN_PATH": "${sourceDir}/.hpm/toolchain",
        "HPM_SDK_TOOLCHAIN_VARIANT": "gcc"
      },
      "cacheVariables": {
        "BOARD": "hpm6e00evk",
        "USE_CCACHE": "0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "python_exec": { "type": "FILEPATH", "value": "${sourceDir}/.hpm/python/python.exe" }
      }
    },
    {
      "name": "debug", "inherits": "base",
      "displayName": "HPM6E00EVK RAM Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "debug", "HPM_BUILD_TYPE": "ram" }
    },
    {
      "name": "release", "inherits": "base",
      "displayName": "HPM6E00EVK RAM Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "release", "HPM_BUILD_TYPE": "ram" }
    },
    {
      "name": "flash-debug", "inherits": "base",
      "displayName": "HPM6E00EVK Flash XIP Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "debug", "HPM_BUILD_TYPE": "flash_xip" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "inheritConfigureEnvironment": true },
    { "name": "release", "configurePreset": "release", "inheritConfigureEnvironment": true },
    { "name": "flash-debug", "configurePreset": "flash-debug", "inheritConfigureEnvironment": true }
  ]
}
